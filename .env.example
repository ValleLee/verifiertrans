# Copy to .env, fill in, then `chmod 600 .env`. Never copy this file into runs/.
DEFAULT_BACKEND=openai_compatible
DEFAULT_BASE_URL=https://provider.example/v1
DEFAULT_MODEL=model-name
DEFAULT_API_KEY=replace-me

# Role-specific overrides (optional; each inherits DEFAULT_* otherwise).
# CONVERTER_MODEL=...
# SOLVER_MODEL=...
# VERIFIER_JUDGE_MODEL=...
# SOLUTION_JUDGE_MODEL=...
# MUTATION_JUDGE_MODEL=...
